# =============================================================================
# Megaweave Frontend — Environment Variables
# cp client/.env.example client/.env.development
# Defaults match server/.env.example and the local Docker services (make dev-services).
# NEXT_PUBLIC_ variables are bundled into browser code: never put secrets here.
# This file is committed; never paste production values into it.
# =============================================================================

# development | production (development shows debug panels such as the delivery page's)
NEXT_PUBLIC_APP_ENV=development

# API origin the browser calls (server PORT, no trailing slash)
NEXT_PUBLIC_HOSTNAME=https://localhost:8443
# Canonical site origin for SEO metadata and the sitemap
NEXT_PUBLIC_SITE_URL=https://localhost:3000
# Avatar effect processing endpoint the profile page POSTs to; avatar upload needs it (no local service)
NEXT_PUBLIC_PROCESS_HOSTNAME=

# Image base URL: the server's CLOUDFRONT_URL (production: https://assets.megaweaving.net)
NEXT_PUBLIC_CLOUDFRONT_CDN=http://127.0.0.1:9000/megaweave-dev
# Lets next/image load from the local S3 mock (origin only); leave unset in production
E2E_IMAGE_ORIGIN=http://127.0.0.1:9000

# Google OAuth 2.0 client id (same as the server's GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Maps JavaScript API key (browser)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Facebook login app id
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Username length limit enforced in the profile form (defaults to 30)
NEXT_PUBLIC_USERNAME_MAX_LENGTH=20

# Build output directory (the E2E stack uses .next-e2e so both can run together)
NEXT_DIST_DIR=.next
