# E2E 前端設定（npm run dev:e2e / build:e2e / start:e2e）；不讀 .env.development，本機與 CI 行為一致。
# 對應 server/e2e.env 與 docker-compose.e2e.yml；只放本機位址與佔位值，不要放入任何 production 設定。
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_HOSTNAME=https://localhost:8543
NEXT_PUBLIC_SITE_URL=https://localhost:3100
NEXT_PUBLIC_CLOUDFRONT_CDN=https://127.0.0.1:29000/megaweave-e2e
# 本機沒有圖片處理服務；指向不存在的 loopback port，避免呼叫 production
NEXT_PUBLIC_PROCESS_HOSTNAME=http://127.0.0.1:9/process
# 第三方 SDK 由 e2e/fixtures/base.ts 阻擋；只需要讓頁面能正常 render 的佔位值
NEXT_PUBLIC_GOOGLE_CLIENT_ID=e2e-placeholder.apps.googleusercontent.com
NEXT_PUBLIC_FACEBOOK_APP_ID=e2e-placeholder
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=e2e-placeholder
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_TEST_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# 與 npm run dev 使用不同的 build 目錄，兩者可同時執行
NEXT_DIST_DIR=.next-e2e
# next.config.ts：允許 next/image 讀取本機 S3 mock
E2E_IMAGE_ORIGIN=https://127.0.0.1:29000
# next/image 讀取 S3Mock 的自簽憑證
NODE_TLS_REJECT_UNAUTHORIZED=0
