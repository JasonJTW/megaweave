# =============================================================================
# Megaweave Backend — Environment Variables
# cp server/.env.example server/.env.development
# Defaults work against the local Docker services (make dev-services, docker-compose.dev.yml).
# Only non-secret local values live here: third-party keys are empty or placeholders.
# Never paste production values into this file; it is committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# API listen port (the client calls https://localhost:8443)
PORT=8443
# Serve HTTPS with the mkcert certificate below (see docs/development.md)
ENABLE_HTTPS=true
# Certificate path, relative to the entrypoint directory (server/src in dev)
CERT_PATH=../cert/localhost.crt
# Private key path, relative to the entrypoint directory
KEY_PATH=../cert/localhost.key
# Key passphrase; leave empty for mkcert keys
PASSPHRASE=
# Allowed browser origins, comma-separated
CORS_ORIGINS=https://localhost:3000
# Run the BullMQ workers inside the API process (npm run dev:inline sets it)
RUN_WORKERS_INLINE=false

# -----------------------------------------------------------------------------
# Session / cookies
# -----------------------------------------------------------------------------
# Session cookie name (client/middleware.ts reads it)
COOKIE_SESSION_KEY=session-id
# Role cookie name (client/middleware.ts reads it)
ROLE_SESSION_KEY=user-role
# Redis key prefix for session hashes
REDIS_SESSION_KEY=session
# Cookie Domain attribute; production uses .megaweaving.net, empty means host-only
COOKIE_DOMAIN=localhost

# -----------------------------------------------------------------------------
# MySQL (docker-compose.dev.yml service "mysql")
# -----------------------------------------------------------------------------
# Database host; keep it local, never the production server
DB_HOST=127.0.0.1
# Dev MySQL port (3307 avoids a native MySQL on 3306)
DB_PORT=3307
# Database user created by the container
DB_USER=megaweave
# Local container password, not a secret
DB_PASSWORD=megaweave
# Database name created and initialised from server/db/schema.sql
DB_DATABASE=megaweave_dev
# Pool size when APP_ROLE is unset (scripts)
DB_CONNECTION_LIMIT=10
# Pool size for the API process (APP_ROLE=api)
API_DB_CONNECTION_LIMIT=10
# Pool size for the worker process (APP_ROLE=worker)
WORKER_DB_CONNECTION_LIMIT=5

# -----------------------------------------------------------------------------
# Redis (docker-compose.dev.yml; production URLs carry a password)
# -----------------------------------------------------------------------------
# Cache: sessions, Socket.IO, cooldowns, trending
REDIS_CACHE_URL=redis://localhost:6379
# Queue: BullMQ jobs
REDIS_QUEUE_URL=redis://localhost:6380
# Vector: Redis Stack HNSW index
REDIS_VECTOR_URL=redis://localhost:6381

# -----------------------------------------------------------------------------
# Image storage: S3 (production) or the local S3 mock (docker-compose.dev.yml "s3")
# -----------------------------------------------------------------------------
# S3 endpoint override read by the AWS SDK; remove it in production. Use 127.0.0.1, not localhost (path-style addressing)
AWS_ENDPOINT_URL_S3=http://127.0.0.1:9000
# AWS access key id; the mock accepts any value
ACCESS_KEY=local-dev-access-key
# AWS secret access key; the mock accepts any value
SECRET_ACCESS_KEY=local-dev-secret-key
# Bucket region
BUCKET_REGION=us-east-1
# Bucket for uploaded originals
BUCKET_NAME=megaweave-dev
# Bucket for presigned browser uploads before the worker moves them
STAGING_BUCKET_NAME=megaweave-dev-staging
# Bucket the image-resizer Lambda writes variants to (no Lambda locally: same bucket)
DESTINATION_BUCKET=megaweave-dev
# Public base URL for image links (production: the CloudFront domain)
CLOUDFRONT_URL=http://127.0.0.1:9000/megaweave-dev
# Key prefix for avatars
S3_BUCKET_AVATAR_FOLDER=avatars
# Maximum images per upload
UPLOAD_IMAGE_LIMIT=5

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# log = print recipient and subject instead of sending; unset or resend = send through Resend (log is refused in production)
EMAIL_TRANSPORT=log
# Resend API key; not needed while EMAIL_TRANSPORT=log
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Google
# -----------------------------------------------------------------------------
# OAuth 2.0 client id (same as the client's NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Geocoding key for scripts/backfillLocationUrls.ts only
GOOGLE_MAPS_API_KEY=
# Fallback Maps key for the same script
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# OpenAI (post and user embeddings)
# -----------------------------------------------------------------------------
# API key; use a key with a spending cap
OPENAI_API_KEY=
# Optional API base URL read by the OpenAI SDK; leave empty for api.openai.com (E2E points it at a local mock)
OPENAI_BASE_URL=

# -----------------------------------------------------------------------------
# ECPay (use the sandbox merchant from ECPay's developer docs locally)
# -----------------------------------------------------------------------------
# Merchant id
ECPAY_MERCHANT_ID=
# HashKey for CheckMacValue
ECPAY_HASH_KEY=
# HashIV for CheckMacValue
ECPAY_HASH_IV=
# Gateway host: payment-stage (sandbox) or payment (production)
ECPAY_HOST=https://payment-stage.ecpay.com.tw
# Server-to-server payment notification URL; needs a public HTTPS tunnel locally
ECPAY_RETURN_URL=
# Browser redirect after payment (client page)
ECPAY_ORDER_RESULT_URL=https://localhost:3000/delivery
# "Back to store" button URL on the payment page
ECPAY_CLIENT_BACK_URL=https://localhost:3000/delivery

# -----------------------------------------------------------------------------
# Lalamove (delivery)
# -----------------------------------------------------------------------------
# API key (sandbox locally)
LALAMOVE_API_KEY=
# API secret, also verifies webhook signatures
LALAMOVE_API_SECRET=
# sandbox | production
LALAMOVE_ENV=sandbox
# Market code
LALAMOVE_MARKET=TW

# -----------------------------------------------------------------------------
# Ministry of Environment open data (npm run check:emission-factors only)
# -----------------------------------------------------------------------------
# Key from https://data.moenv.gov.tw; not used at runtime
MOENV_API_KEY=

# -----------------------------------------------------------------------------
# Client URLs (absolute links built by the server)
# -----------------------------------------------------------------------------
# Client origin for payment redirects; falls back to the first CORS origin
NEXT_PUBLIC_CLIENT_URL=https://localhost:3000
# Site origin for links in notifications and emails
NEXT_PUBLIC_HOSTNAME=https://localhost:3000

# -----------------------------------------------------------------------------
# Rate limiting (limits are bypassed when NODE_ENV=development unless enabled)
# -----------------------------------------------------------------------------
# true skips every limiter in any environment
RATE_LIMIT_DISABLED=false
# true enforces the limits in development
ENABLE_RATE_LIMIT_DEV=false
# true enforces the limits when NODE_ENV=test
ENABLE_RATE_LIMIT_TEST=false
# Global limiter window in ms
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
# Global limiter requests per window
GLOBAL_RATE_LIMIT_MAX=120
# Auth burst limiter window in ms
AUTH_BURST_RATE_LIMIT_WINDOW_MS=10000
# Auth burst limiter requests per window
AUTH_BURST_RATE_LIMIT_MAX=5
# Auth sustained limiter window in ms
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Auth sustained limiter requests per window
AUTH_RATE_LIMIT_MAX=10

# -----------------------------------------------------------------------------
# Dev seed accounts (make dev-seed; same fixtures as E2E, local only)
# -----------------------------------------------------------------------------
# Native sign-in account created by the seed
E2E_USER_EMAIL=dev-user@megaweave.test
# Its password (local fixture, not a secret)
E2E_USER_PASSWORD=dev-password-123
# Its display name
E2E_USER_NAME=Dev User
# Org viewer account created by the org isolation fixture
E2E_ORG_VIEWER_EMAIL=dev-org-viewer@megaweave.test
# Its password (local fixture, not a secret)
E2E_ORG_VIEWER_PASSWORD=dev-org-viewer-123
