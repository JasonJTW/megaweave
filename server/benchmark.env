# Benchmark 連線設定，對應 docker-compose.benchmark.yml 的本機容器。
# 只包含本機 docker 預設帳密；不要在此放入任何 production 設定。
# npm run benchmark 會以此檔覆蓋 shell 中的同名變數。
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=benchmark
DB_PASSWORD=benchmark
DB_DATABASE=megaweave_benchmark
DB_CONNECTION_LIMIT=10
API_DB_CONNECTION_LIMIT=15
WORKER_DB_CONNECTION_LIMIT=5
REDIS_CACHE_URL=redis://127.0.0.1:16379
REDIS_QUEUE_URL=redis://127.0.0.1:16380
REDIS_VECTOR_URL=redis://127.0.0.1:16381
REDIS_SESSION_KEY=session
COOKIE_SESSION_KEY=session-id
ROLE_SESSION_KEY=user-role
# benchmark:api 啟動 API 所需；feed benchmark 不會使用 Google 登入，故以不存在的 client id 佔位
GOOGLE_CLIENT_ID=benchmark-placeholder.apps.googleusercontent.com
# 外部服務一律指向 queue-burst profile 在 runner 內啟動的 loopback mock；
# API 與 worker 載入此檔後永遠不會連到真實的 OpenAI 或 S3，mock 未啟動時呼叫會直接失敗。
OPENAI_API_KEY=benchmark-mock-key
OPENAI_BASE_URL=http://127.0.0.1:18090/v1
AWS_ENDPOINT_URL_S3=http://127.0.0.1:18091
BUCKET_REGION=us-east-1
BUCKET_NAME=megaweave-benchmark
STAGING_BUCKET_NAME=megaweave-benchmark-staging
DESTINATION_BUCKET=megaweave-benchmark-thumbnails
ACCESS_KEY=benchmark
SECRET_ACCESS_KEY=benchmark
CLOUDFRONT_URL=
