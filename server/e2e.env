# E2E 連線設定，對應 docker-compose.e2e.yml 的本機容器。
# 只包含本機 docker 預設帳密與假的 API key；不要在此放入任何 production 設定。
# npm run e2e:* 會以此檔覆蓋 shell 中的同名變數。
NODE_ENV=development
HOSTNAME=0.0.0.0
# 與 dev (:3000 / :8443) 錯開，E2E 可與 dev server 同時執行
PORT=8543
ENABLE_HTTPS=true
CERT_PATH=../cert/localhost.crt
KEY_PATH=../cert/localhost.key
CORS_ORIGINS=https://localhost:3100
COOKIE_DOMAIN=localhost

DB_HOST=127.0.0.1
DB_PORT=23306
DB_USER=e2e
DB_PASSWORD=e2e
DB_DATABASE=megaweave_e2e
DB_CONNECTION_LIMIT=10
API_DB_CONNECTION_LIMIT=10
WORKER_DB_CONNECTION_LIMIT=5
REDIS_CACHE_URL=redis://127.0.0.1:26379
REDIS_QUEUE_URL=redis://127.0.0.1:26380
REDIS_VECTOR_URL=redis://127.0.0.1:26381
# 與 client/middleware.ts 讀取的 cookie 名稱一致
REDIS_SESSION_KEY=session
COOKIE_SESSION_KEY=session-id
ROLE_SESSION_KEY=user-role

# E2E 測試帳號：npm run e2e:seed 每次重置後建立
E2E_USER_EMAIL=e2e-user@megaweave.test
E2E_USER_PASSWORD=e2e-password-123
E2E_USER_NAME=E2E User

# 外部服務一律使用假的 key，並把可設定端點的服務指向 loopback；
# 即使 mock 未啟動或設定遺漏，也不會連到真實帳號或寫入 production 資源。
GOOGLE_CLIENT_ID=e2e-placeholder.apps.googleusercontent.com
# npm run e2e:mock-openai（Playwright 會自動啟動）
OPENAI_API_KEY=e2e-fake-openai-key
OPENAI_BASE_URL=http://127.0.0.1:28090/v1
# docker-compose.e2e.yml 的 S3Mock（不驗證簽章，HTTPS 自簽憑證）；S3 SDK 對 IP 端點使用 path-style
AWS_ENDPOINT_URL_S3=https://127.0.0.1:29000
ACCESS_KEY=e2e-fake-access-key
SECRET_ACCESS_KEY=e2e-fake-secret-key
BUCKET_REGION=us-east-1
BUCKET_NAME=megaweave-e2e
STAGING_BUCKET_NAME=megaweave-e2e-staging
# 沒有 image-resizer Lambda，縮圖不會產生；與 CLOUDFRONT_URL 指向同一 bucket 以維持相同的 key 結構
DESTINATION_BUCKET=megaweave-e2e
CLOUDFRONT_URL=https://127.0.0.1:29000/megaweave-e2e
# 接受 S3Mock 的自簽憑證；此檔所有外部端點都是本機或假的 key
NODE_TLS_REJECT_UNAUTHORIZED=0
S3_BUCKET_IMAGE_FOLDER=posts
S3_BUCKET_AVATAR_FOLDER=avatars
UPLOAD_IMAGE_LIMIT=5
RESEND_API_KEY=e2e-fake-resend-key
LALAMOVE_API_KEY=e2e-fake-lalamove-key
LALAMOVE_API_SECRET=e2e-fake-lalamove-secret
LALAMOVE_ENV=sandbox
LALAMOVE_MARKET=TW
ECPAY_MERCHANT_ID=e2e-fake-merchant
ECPAY_HASH_KEY=e2e-fake-hash-key
ECPAY_HASH_IV=e2e-fake-hash-iv
ECPAY_HOST=https://payment-stage.ecpay.com.tw
ECPAY_RETURN_URL=https://localhost:8543/api/ecpay/return
ECPAY_ORDER_RESULT_URL=https://localhost:3100/delivery
ECPAY_CLIENT_BACK_URL=https://localhost:3100/delivery
