{
  "name": "server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "jest",
    "build": "dotenv -e .env.production -- tsc -p tsconfig.build.json",
    "build:dev": "dotenv -e .env.development -- tsc -p tsconfig.build.json",
    "start": "dotenv -e .env.production -v APP_ROLE=api -- node ./dist/server.js",
    "start:api": "dotenv -e .env.production -v APP_ROLE=api -- node ./dist/server.js",
    "start:worker": "dotenv -e .env.production -v APP_ROLE=worker -- node ./dist/worker.js",
    "dev": "dotenv -e .env.development -v APP_ROLE=api -- nodemon ./src/server.ts",
    "dev:api": "dotenv -e .env.development -v APP_ROLE=api -- nodemon ./src/server.ts",
    "dev:worker": "dotenv -e .env.development -v APP_ROLE=worker -- nodemon ./src/worker.ts",
    "sync:vectors": "dotenv -e .env.development -- ts-node src/scripts/syncVectorsToRedis.ts",
    "benchmark": "dotenv -o -e benchmark.env -- ts-node src/scripts/benchmark.ts",
    "benchmark:api": "dotenv -o -e benchmark.env -v APP_ROLE=api -v PORT=18443 -v ENABLE_HTTPS=false -v RATE_LIMIT_DISABLED=true -v BENCHMARK_TARGET_MARKER=megaweave-isolated -- sh -c 'tsc -p tsconfig.build.json && node ./dist/server.js'",
    "docker:redis": "docker compose -f ../docker-compose.dev.yml up -d",
    "docker:redis:stop": "docker compose -f ../docker-compose.dev.yml down",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "npx tsc --noEmit"
  },
  "author": "Jhang Jyun Hao",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@lalamove/lalamove-js": "^1.1.0",
    "@redis/client": "^5.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.0.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv-cli": "^8.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^10.1.0",
    "ioredis": "^6.0.0",
    "lodash": "^4.17.21",
    "multer": "^2.0.1",
    "multer-s3": "^3.0.1",
    "mysql2": "^3.14.0",
    "openai": "^7.4.0",
    "rate-limit-redis": "^4.3.1",
    "react": "^19.2.7",
    "react-email": "^6.6.0",
    "resend": "^6.12.4",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.16",
    "@types/multer": "^2.0.0",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^22.13.14",
    "@types/react": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.23.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0"
  }
}
